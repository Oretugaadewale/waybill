# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Both values are public by design; Row Level Security protects the data.
# Leave them empty to run on the bundled sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paystack secret key. Use the test key (sk_test_...) for the demo.
PAYSTACK_SECRET_KEY=
# From `select public.create_server_key();` in the Supabase SQL editor.
WAYBILL_SERVER_KEY=
